# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Lấy từ: https://neon.tech → Project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/artdict?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Cloudinary (Phase 3) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── MoMo (Phase 4) ───────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/payment/return
MOMO_IPN_URL=http://localhost:3000/api/orders/momo-callback

# ─── Resend Email (Phase 4 + 6) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Artdict <no-reply@artdict.vn>"
# Hộp thư admin nhận hồ sơ ứng tuyển nghệ sĩ (POST /api/artists/apply)
ADMIN_EMAIL="admin@artdict.vn"
# Mật khẩu admin để seed tài khoản đăng nhập admin panel (npm run db:seed)
ADMIN_PASSWORD="change-me-admin-password"

# ─── Frontend URL (CORS) ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
