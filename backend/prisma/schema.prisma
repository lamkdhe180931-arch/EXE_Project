generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String
  role         Role           @default(CUSTOMER)
  passwordHash String
  createdAt    DateTime       @default(now())
  orders       Order[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Artist {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  role      String
  city      String
  since     Int
  avatarUrl String?
  content   Json      // { quote: string, qa: [{id, q, a}] }
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  price       Int            // VND, không dùng float
  stock       Int            @default(0)
  artistId    Int?
  category    String
  description String?        // mô tả sản phẩm (hiện ở trang chi tiết)
  isActive    Boolean        @default(true)
  images     ProductImage[]
  artist     Artist?        @relation(fields: [artistId], references: [id])
  orderItems OrderItem[]
  createdAt  DateTime       @default(now())
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                  Int         @id @default(autoincrement())
  userId              Int?
  guestEmail          String?
  guestName           String?
  guestPhone          String?
  status              OrderStatus @default(PENDING)
  total               Int         // VND
  momoTransactionId   String?
  shippingAddress     String?
  createdAt           DateTime    @default(now())
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  qty          Int
  priceAtTime  Int     // snapshot giá lúc mua
  size         String?
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
}

// ─── Content ─────────────────────────────────────────────────────────────────

enum PostType {
  NEWS
  JOURNAL
}

model Post {
  id          Int      @id @default(autoincrement())
  type        PostType
  title       String
  slug        String   @unique
  body        String
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}
