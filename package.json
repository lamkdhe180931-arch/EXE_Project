{
  "name": "artdict",
  "version": "1.0.0",
  "description": "A premium minimalist Art Gallery, Artist Showcase, and Streetwear Product Catalogue website connecting student designers with collectors.",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:smoke": "node scratch/verify_index.js && node scratch/verify.js && node scratch/verify_authors.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "art-gallery",
    "portfolio",
    "minimalist-design",
    "streetwear-showcase",
    "wavy-slider",
    "interactive-ui",
    "responsive-design",
    "browser-sync",
    "playwright-testing"
  ],
  "author": "Artdict Studio <contact@artdict.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamkdhe180931-arch/EXE_Project.git"
  },
  "bugs": {
    "url": "https://github.com/lamkdhe180931-arch/EXE_Project/issues"
  },
  "homepage": "https://github.com/lamkdhe180931-arch/EXE_Project#readme",
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "browser-sync": "^3.0.3",
    "playwright": "^1.60.0",
    "prettier": "^3.2.5",
    "prisma": "6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "15.5.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  }
}
